{
  "schema": 1,
  "groups": {
    "blizzard-ui": {
      "folders": [
        "Blizzard_AuctionUI",
        "Blizzard_BattlefieldMinimap",
        "Blizzard_BindingUI",
        "Blizzard_CombatText",
        "Blizzard_CraftUI",
        "Blizzard_GMSurveyUI",
        "Blizzard_InspectUI",
        "Blizzard_MacroUI",
        "Blizzard_RaidUI",
        "Blizzard_TalentUI",
        "Blizzard_TradeSkillUI",
        "Blizzard_TrainerUI"
      ],
      "name": "Blizzard interface",
      "category": "Client",
      "required": true,
      "description": "Stock 1.12 UI panels — auction house, talents, macros, raid frames. Part of the client, not an optional addon.",
      "source": {
        "kind": "client"
      }
    },
    "turtle-ui": {
      "folders": [
        "Turtle_General",
        "Turtle_GroupUI"
      ],
      "name": "Turtle interface",
      "category": "Client",
      "required": true,
      "description": "Turtle's own UI additions. Ships with the client.",
      "source": {
        "kind": "client"
      }
    },
    "classicapi": {
      "folders": [
        "!!!ClassicAPI"
      ],
      "name": "ClassicAPI",
      "category": "Client",
      "required": true,
      "description": "Lua side of ClassicAPI.dll. Loads first (hence the !!! prefix) because other addons call into it.",
      "source": {
        "kind": "bundled"
      }
    },
    "superapi": {
      "folders": [
        "SuperAPI"
      ],
      "name": "SuperAPI",
